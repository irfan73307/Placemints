datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -----------------------------------------------------------------------------
// CORE AUTHENTICATION & USER MANAGEMENT
// -----------------------------------------------------------------------------

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  googleId     String?   @unique
  passwordHash String?
  role           String    @default("student") // "student" | "admin"
  isPrimaryAdmin Boolean   @default(false)
  isActive       Boolean   @default(true)
  lastLoginAt    DateTime? @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt

  // Convenience flat fields for legacy compatibility
  name                 String?
  fullName             String?
  avatar               String?
  avatarUrl            String?
  department           String?
  degree               String?        @default("B.Tech")
  graduationYear       Int?           @default(2026)
  section              String?
  rollNumber           String?
  rollNo               String?
  branch               String?        @default("CSE")
  batchYear            Int?           @default(2026)
  cgpa                 String?        @default("8.50")
  placementGoal        String?        @default("Software Engineer (SDE-1)")
  targetRole           String?        @default("Software Engineer")
  interestedRoles      String?
  programmingLanguages String?
  frameworks           String?
  technologies         String?
  github               String?
  linkedin             String?
  leetcode             String?
  codeforces           String?
  codechef             String?
  resume               String?
  bio                  String?
  profileCompleted     Boolean        @default(false)

  // Explicit Relations
  studentProfile  StudentProfile?
  notifications   Notification[]
  activityHistory ActivityHistory[]
  questions       Question[]
  likes           QuestionLike[]
  resources       Resource[]
  reviews         Review[]
  savedCompanies  SavedCompany[]
  refreshTokens   RefreshToken[]

  @@index([email])
  @@index([role])
}

// -----------------------------------------------------------------------------
// STUDENT PROFILES & ENTITIES
// -----------------------------------------------------------------------------

model StudentProfile {
  id                   String   @id @default(uuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName             String
  email                String
  avatar               String?
  department           String   @default("CSE") // "CSE" | "ECE" | "EEE" | "IT" | "MECH" | "CIVIL" | "AIDS"
  degree               String   @default("B.Tech")
  graduationYear       Int      @default(2026)
  section              String?  @default("A")
  rollNumber           String?  @unique
  cgpa                 String   @default("8.50")
  placementGoal        String   @default("Software Engineer (SDE-1)")
  interestedRoles      String?  // Comma-separated or JSON
  programmingLanguages String?  // Comma-separated or JSON
  frameworks           String?  // Comma-separated or JSON
  technologies         String?  // Comma-separated or JSON
  bio                  String?
  profileCompleted     Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @default(now()) @updatedAt

  codingProfile        CodingProfile?
  resumes              Resume[]
  savedCompanies       SavedCompany[]
  companyProgress      CompanyProgress[]
  interviewExperiences InterviewExperience[]

  @@index([email])
  @@index([rollNumber])
  @@index([department])
  @@index([graduationYear])
  @@index([cgpa])
}

model CodingProfile {
  id               String         @id @default(uuid())
  studentProfileId String         @unique
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  github           String?
  linkedin         String?
  leetcode         String?
  codeforces       String?
  codechef         String?
  leetcodeSolved   Int?           @default(0)
  codeforcesRating Int?           @default(0)
  updatedAt        DateTime       @default(now()) @updatedAt
}

model Resume {
  id               String         @id @default(uuid())
  studentProfileId String
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  fileName         String
  fileUrl          String
  isDefault        Boolean        @default(true)
  createdAt        DateTime       @default(now())
}

model SavedCompany {
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId        String
  company          Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  studentProfileId String?
  studentProfile   StudentProfile? @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  createdAt        DateTime        @default(now())

  @@id([userId, companyId])
}

model CompanyProgress {
  id               String         @id @default(uuid())
  studentProfileId String
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  companyId        String
  company          Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  status           String         @default("BOOKMARKED") // "BOOKMARKED" | "APPLIED" | "OA_CLEARED" | "INTERVIEW" | "OFFERED" | "REJECTED"
  notes            String?
  targetDate       DateTime?
  updatedAt        DateTime       @default(now()) @updatedAt

  @@unique([studentProfileId, companyId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("info") // "info" | "success" | "warning"
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model ActivityHistory {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  metadata  String?
  createdAt DateTime @default(now())
}

model InterviewExperience {
  id               String         @id @default(uuid())
  studentProfileId String
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  companyId        String
  company          Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role             String
  verdict          String         @default("OFFERED") // "OFFERED" | "REJECTED"
  content          String
  rating           Int            @default(5)
  createdAt        DateTime       @default(now())
}

// -----------------------------------------------------------------------------
// COMPANY & RECRUITMENT ARCHIVES
// -----------------------------------------------------------------------------

model Company {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  logo        String?  // Database-stored official logo URL
  logoUrl     String?  // Secondary logo URL
  customLogo  String?  // Admin uploaded custom logo URL (highest priority)
  website     String?  // Company official website domain
  tier        String?
  ctc         String?
  avgCtc      Float?   @default(0.0)
  description String
  sector      String?  @default("IT")
  tags        String   // Comma-separated tags
  createdAt   DateTime @default(now())

  rounds              InterviewRound[]
  questions           Question[]
  stats               PlacementStat[]
  reviews             Review[]
  savedBy             SavedCompany[]
  progressRecords     CompanyProgress[]
  interviewExperiences InterviewExperience[]
}

model InterviewRound {
  id          String     @id @default(uuid())
  companyId   String
  company     Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  roundNumber Int
  title       String
  description String
  questions   Question[]
}

model Question {
  id            String          @id @default(uuid())
  companyId     String
  company       Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  roundId       String?
  round         InterviewRound? @relation(fields: [roundId], references: [id], onDelete: SetNull)
  questionText  String
  topicTags     String          // Comma-separated tags
  difficulty    String          @default("Medium")
  year          Int             @default(2024)
  frequency     Int?            // Real historical ask-frequency %, 0-100, from source CSV
  leetcodeUrl   String?         // Real verified LeetCode/problem link, from source CSV
  likeCount     Int             @default(0)
  contributedBy String?
  contributor   User?           @relation(fields: [contributedBy], references: [id], onDelete: SetNull)
  createdAt     DateTime        @default(now())

  likes QuestionLike[]
}

model QuestionLike {
  userId     String
  questionId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([userId, questionId])
}

model PlacementStat {
  id                  String  @id @default(uuid())
  companyId           String
  company             Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  year                Int
  studentsPlaced      Int
  avgCtc              Float
  maxCtc              Float
  eligibilityCriteria String?
}

model Resource {
  id         String   @id @default(uuid())
  title      String
  type       String   @default("PDF Guide")
  url        String
  tags       String   // Comma-separated
  uploadedBy String?
  uploader   User?    @relation(fields: [uploadedBy], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())
}

model Review {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String
  createdAt DateTime @default(now())
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  revoked   Boolean  @default(false)
}
